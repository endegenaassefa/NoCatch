# Server operator secrets: never put this file in a desktop build.
OIDC_ISSUER=https://YOUR-TENANT.example.com/
OIDC_AUDIENCE=https://api.example.com
OIDC_JWKS_URL=https://YOUR-TENANT.example.com/.well-known/jwks.json
# Optional pilot invitation list, exact OIDC subjects separated by commas.
OIDC_ALLOWED_SUBJECTS=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
DEEPSEEK_MODEL=deepseek-chat
PORT=8080
DATABASE_PATH=./data/managed.sqlite
DAILY_ACCOUNT_REQUESTS=50
DAILY_GLOBAL_REQUESTS=1000
ACTIVE_ACCOUNT_REQUESTS=2
ACTIVE_GLOBAL_REQUESTS=20
REQUEST_TIMEOUT_SECONDS=90
RETENTION_HOURS=24
MAX_STORED_REQUESTS=2000
