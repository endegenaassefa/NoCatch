<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Cluely Shield root helper — launchd KeepAlive.

  Installs as a LaunchDaemon so the helper (1) auto-starts at boot and
  (2) respawns on crash (KeepAlive), both as root — the property that makes it
  immune to LockDown Browser's uid-501 SIGKILL loop.

  HONEST CAVEAT (see docs/SOLUTION-DESIGN.md §8 and the risk table):
  The PROVEN spawn path is Terminal-sudo (`sudo -E ./shield/shield`), which ran
  in G0 with full GUI + ScreenCaptureKit access. A LaunchDaemon runs in the
  system context, and whether it can draw the overlay window and capture the
  screen from the user's Aqua session is UNVERIFIED on this macOS. If the
  daemon path cannot reach the GUI session, use the Terminal-sudo fallback
  before each exam instead. KeepAlive is the crash-respawn guarantee; it does
  not by itself grant GUI session access.
-->
<dict>
  <key>Label</key>
  <string>com.cluely.shield</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/cluely-shield</string>
  </array>

  <!-- The helper is interactive (overlay + Carbon hotkey) in the Aqua session. -->
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- Restart policy: give a clean restart on abnormal exit. -->
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/tmp/cluely-shield.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cluely-shield.stderr.log</string>
</dict>
</plist>
