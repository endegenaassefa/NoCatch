{
  "name": "screen-reader-util",
  "version": "1.1.0-beta.1",
  "description": "Personal desktop reading assistant",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --no-sandbox --disable-gpu",
    "test:packaging": "node --test scripts/test-packaging.js scripts/test-managed-config-packaging.js",
    "test-speech": "node scripts/test-speech.js",
    "build": "node scripts/build.js",
    "build:mac": "node scripts/build.js mac",
    "build:win": "node scripts/build.js win",
    "build:linux": "node scripts/build.js linux",
    "build:all": "node scripts/build.js all",
    "dist": "npm run build",
    "pack": "node scripts/build.js --dir",
    "clean": "node scripts/clean.js",
    "rebuild": "npm run clean && npm run build",
    "release": "node scripts/build.js --release",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": {
    "name": "screen-reader-util contributors"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@google/genai": "^2.9.0",
    "dotenv": "^16.3.1",
    "fast-xml-parser": "5.11.2",
    "markdown": "^0.5.0",
    "marked": "^15.0.12",
    "microsoft-cognitiveservices-speech-sdk": "^1.40.0",
    "node-record-lpcm16": "^1.0.1",
    "pdfjs-dist": "6.3.289",
    "prismjs": "^1.30.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^4.7.1",
    "yauzl": "3.4.0",
    "@huggingface/transformers": "3.8.1",
    "@napi-rs/canvas": "1.0.9"
  },
  "devDependencies": {
    "electron": "^44.4.4",
    "electron-builder": "26.15.3",
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "com.screenreaderutil.app",
    "productName": "screen-reader-util",
    "artifactName": "OpenCluely-${version}-${os}-${arch}.${ext}",
    "beforePack": "scripts/before-pack.js",
    "afterPack": "scripts/verify-package.js",
    "publish": {
      "provider": "github",
      "owner": "endegenaassefa",
      "repo": "NoCatch",
      "releaseType": "draft"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "prompt-loader.js",
      "speech-recognition.js",
      "onboarding.js",
      "managed-config.json",
      "*.html",
      "src/**/*",
      "lib/**/*",
      "assets/**/*",
      "prompts/**/*",
      "scripts/whisper_worker.py",
      "env.example",
      "LICENSE",
      "!**/__pycache__/**/*",
      "!**/*.pyc",
      "server/providers.js"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/@napi-rs/**/*",
      "assets/icons/**/*",
      "prompts/**/*",
      "scripts/whisper_worker.py"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "13.0.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/bin/keystroke-capture"
      ],
      "extraResources": [
        {
          "from": "resources/bin/${arch}",
          "to": "bin"
        }
      ],
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "screen-reader-util uses the microphone for local Whisper or Azure cloud transcription, according to your selected voice provider.",
        "NSCameraUsageDescription": "screen-reader-util does not record video; this entitlement is only present for media-capture compatibility.",
        "NSScreenCaptureUsageDescription": "screen-reader-util captures the screen to read on-screen content for AI assistance."
      }
    },
    "win": {
      "extraResources": [
        {
          "from": ".depthengine/speech-runtime/windows-x64",
          "to": "speech-runtime/windows-x64",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "scripts/cluely-admin.ps1",
          "to": "launcher/cluely-admin.ps1"
        },
        {
          "from": "scripts/cluely-admin.cmd",
          "to": "launcher/cluely-admin.cmd"
        },
        {
          "from": "scripts/SystemLauncher.cs",
          "to": "launcher/SystemLauncher.cs"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/app-icon.png",
      "category": "Utility"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xauth",
        "libasound2t64",
        "libgbm1",
        "python3 (>= 3.10)",
        "python3-venv",
        "python3-pip"
      ],
      "recommends": [
        "ffmpeg"
      ],
      "fpm": [
        "--after-install=scripts/post-install-deb.sh"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenCluely",
      "include": "scripts/post-install-nsis.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "OpenCluely-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "OpenCluely-Portable-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "screen-reader-util",
      "backgroundColor": "#000000",
      "window": {
        "width": 600,
        "height": 400
      }
    }
  }
}
